# Model access: gemini = Gemini API key (works in any container); vertex = gcloud ADC (local development)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# For LLM_PROVIDER=vertex only
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# OpenAI key: the default checker gpt-6.1-sol needs it
OPENAI_API_KEY=

# Models: the inducer writes and revises the rules, the checker applies them to every conversation.
# Gemini and OpenAI models can be mixed; the provider follows the model name.
INDUCER_MODEL=gemini-4-argon
CHECKER_MODEL=gpt-6.1-sol
# Thinking depth: Gemini thinking_level or OpenAI reasoning_effort, e.g. low or high; empty = model default
INDUCER_THINKING_LEVEL=
CHECKER_THINKING_LEVEL=

# Hard cap on estimated model spend per adapt or eval run, USD
SPEND_LIMIT_USD=40

# Checker runs per conversation, refinement rounds, parallel calls
VOTES=3
REFINE_ROUNDS=2
MAX_CONCURRENCY=16

# Time budgets in seconds; when a budget runs out, the remaining conversations keep fallback labels
ADAPT_TIME_BUDGET_S=3000
EVAL_TIME_BUDGET_S=1500

# Development only
LLM_CACHE_DIR=
ONLY_TOPICS=
